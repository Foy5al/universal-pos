# Builds and runs the Express API (apps/api) from the pnpm workspace.
# Build context is the repository root:
#   docker build -f infra/Dockerfile.api .

FROM node:22-alpine AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /app

# Install dependencies for the whole workspace using the frozen lockfile.
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/domain/package.json packages/domain/package.json
RUN pnpm install --frozen-lockfile

# Bundle the API (tsup inlines @pos/* workspace sources) into dist/.
FROM deps AS build
COPY . .
RUN pnpm --filter @pos/api build

# Runtime image also serves as the migration/seed runner in compose.
FROM base AS runtime
ENV NODE_ENV=production
ENV PORT=4000
COPY --from=build /app ./
EXPOSE 4000
CMD ["node", "apps/api/dist/server.js"]
