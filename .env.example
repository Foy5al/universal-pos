# Universal POS — environment template. Copy to .env and fill real values.
# Never commit secrets. Server-side values must not be exposed to the client.

# API
NODE_ENV=development
PORT=4000
# Base URL used by the web app and offline POS client to reach the API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Build-time target of the web app's /api rewrite, used by local dev and Docker.
# Not needed on Vercel Services, which route /api/* before Next.js runs.
API_PROXY_TARGET=http://localhost:4000

# Database (Neon pooled URL for dev; Docker/self-hosted for production)
DATABASE_URL=postgresql://pos:pos@localhost:5432/pos
# Max Postgres connections per process. Defaults to 1 on Vercel, 10 elsewhere;
# serverless deployments should use a pooled connection URL.
DATABASE_POOL_MAX=

# Demo login created by `pnpm db:seed:demo` (development only).
DEMO_EMAIL=owner@demo.pos
DEMO_PASSWORD=password123

# Sessions / auth
SESSION_SECRET=replace-with-32-plus-random-bytes
SESSION_COOKIE_NAME=pos_session
SESSION_TTL_HOURS=12

# Object storage (S3-compatible). Default: Backblaze B2 free tier (10 GB, no card).
# Local alternative: MinIO via `docker compose -f infra/docker-compose.yml up -d`
#   STORAGE_ENDPOINT=http://localhost:9000   STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=https://s3.us-west-004.backblazeb2.com
STORAGE_REGION=us-west-004
STORAGE_BUCKET=universal-pos-dev
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# PWA / offline
PWA_CACHE_VERSION=1
NEXT_PUBLIC_APP_NAME="Universal POS"
